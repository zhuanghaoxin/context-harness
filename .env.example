# ContextHarness 配置。复制一份：cp .env.example .env
# 全部可选：不填就走离线模式（ScriptedLLM + 哈希 embedding，零成本跑通全流程）

# ---- 真实模型（OpenAI 兼容端点；不填则 offline） ----
CH_BASE_URL=https://api.deepseek.com/v1
CH_API_KEY=
CH_MODEL=deepseek-chat
CH_SMALL_MODEL=deepseek-chat

# ---- 主循环 ----
CH_MAX_STEPS=16
CH_CONTEXT_BUDGET=8000
CH_DB_PATH=.artifacts/harness.sqlite3
CH_ARTIFACT_DIR=.artifacts

# ---- 真实 embedding（不填就用本地哈希向量） ----
# 注意：DeepSeek 端点没有 /embeddings（会 404）。要真向量，用下面三行单独指向别的厂商
# （留空则复用上面的 CH_BASE_URL / CH_API_KEY）
# CH_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# CH_EMBEDDING_API_KEY=sk-xxx
# CH_EMBEDDING_MODEL=BAAI/bge-m3
CH_EMBEDDING_DIM=512
CH_EMBEDDING_CACHE=.artifacts/embedding_cache.sqlite3
CH_EMBEDDING_TIMEOUT=30

# ---- 两级消息过滤（规则层 + 灰区模型） ----
CH_FILTER_ENABLED=true
CH_FILTER_HIGH=0.70
CH_FILTER_LOW=0.30

# ---- Router–Worker ----
CH_MAX_WORKERS=4
CH_QUEUE_FACTOR=3
CH_WORKER_REUSE=0.35

# ---- Watchdog（停滞 / 跑偏） ----
CH_WATCHDOG_STALL=3
CH_WATCHDOG_TOPIC=0.15
CH_WATCHDOG_MIN_TEXT=40

# ---- 离线演示用：模拟每次模型调用延迟（毫秒） ----
CH_SIM_LATENCY_MS=0
